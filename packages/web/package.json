{
  "name": "@localjson/web",
  "version": "4.0.1",
  "description": "Web version - Collection of handy online tools for developers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max_old_space_size=8192 vite build && node ./scripts/generate-sitemap.mjs",
    "build:legacy": "vue-tsc --noEmit && cross-env NODE_OPTIONS=--max_old_space_size=4096 vite build",
    "preview": "vite preview --port 5050",
    "preview:static": "npx http-server dist -p 5050 -c-1 --cors",
    "test": "npm run test:unit",
    "test:unit": "vitest --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:dev": "BASE_URL=http://localhost:5173 NO_WEB_SERVER=true playwright test",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "script:create:tool": "node ../../packages/core/scripts/create-tool.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ../../packages/core/scripts/release.mjs"
  },
  "dependencies": {
    "@localjson/core": "workspace:*",
    "@vicons/tabler": "^0.13.0",
    "plausible-tracker": "^0.3.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1"
  }
}