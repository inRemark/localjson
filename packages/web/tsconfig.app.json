{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "**/*.d.ts", "../**/*.ts", "../**/*.vue"],
  "exclude": ["src/**/__tests__/*", "../**/node_modules/**", "../**/dist/**"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/core/*": ["../core/src/*"],
    },
    "types": ["naive-ui/volar", "@intlify/unplugin-vue-i18n/messages", "unplugin-icons/types/vue"],
    "esModuleInterop": true,
    "jsx": "preserve",
    "skipLibCheck": true
  }
}
